alias clc='xclip -selection clipboard'
alias clp='xclip -o -sel clip'
alias gs-start='aws ec2 start-instances --profile game-server --instance-ids i-04fd368d78d8a7f7d'
alias gs-stop='aws ec2 stop-instances --profile game-server --instance-ids i-04fd368d78d8a7f7d'
alias minecraft-backup='scp -r terraria-server:/home/ec2-user/minecraft/world $GDRIVE/games/minecraft'
alias reconnect='iwctl station wlan0 scan'
alias reconnectto='iwctl station wlan0 disconnect ; sleep 3 ; iwctl station wlan0 connect'
alias redshiftd='redshift -l 47.5:-122.6' # Not Amazon
alias ss='(cd $GDRIVE/dev/resources/ ; jq -r -f ss.jq lds-scriptures.json) | fzf'
alias pw='screen -S pw ~/pokemon-wilds/pokemon-wilds'
alias icat="kitty +kitten icat"
alias wlan0='iwctl station wlan0'
