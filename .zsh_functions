.. () {
  NUMERIC="$(echo $1 | grep -E '^[0-9]+$')"
  if [ -n "$NUMERIC" ]; then
      COUNT=${1:-1}
      DIRCHANGE="."
      while [ $COUNT -gt 0 ]; do 
          echo "| $(cd $DIRCHANGE; pwd)"
          COUNT=$(($COUNT - 1))
          DIRCHANGE="../${DIRCHANGE}"
      done
      cd $DIRCHANGE
      echo "> $(pwd)"
      DIRCHANGE=""
  else
      EXISTS="$(dirname "`pwd`" | grep "$1")"
      if [ -n "$EXISTS" ]; then
          DIRPWD="$(pwd)"
          MATCH=""
          while [ -z "$MATCH" ]; do
              echo "| $DIRPWD"
              DIRPWD="$(dirname $DIRPWD)"
              DIRBASE="$(basename $DIRPWD)"
              MATCH=`echo "$DIRBASE" | grep "$1"`
          done
          cd "$DIRPWD"
          echo "> $(pwd)"
          DIRPWD=""
          DIRBASE=""
      else 
          echo "Usage: Optional parameter must match a parent directory's name or a number"
      fi
      EXISTS=""
  fi
}

..simple () {
  COUNT=${1:-1}
  DIRCHANGE="."
  while [ $COUNT -gt 0 ]; do 
    echo "| $(cd $DIRCHANGE; pwd)"
    COUNT=$(($COUNT - 1))
    DIRCHANGE="../${DIRCHANGE}"
  done
  cd $DIRCHANGE
  echo "> $(pwd)"

}

function panview {
    pandoc "$1" -f markdown -t latex -o ./out.pdf
    open ./out.pdf
}

cpfp () {
    echo `pwd`/$1 | pbcopy
}

[ -f ~/.zsh_functions.local ] && source ~/.zsh_functions.local
